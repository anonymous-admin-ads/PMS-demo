# ==============================================================================
# Property Management System (PMS) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production environment.
# NEVER commit .env files containing real secrets, keys, or passwords.
# NEVER prefix database or server secrets with VITE_ (prevents client bundle leakage).
# ==============================================================================

# Application Environment & Server Settings
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Database Configuration: PostgreSQL Hosted on Supabase
# ==============================================================================
# Supabase provides two connection strings in Project Settings -> Database:
#
# 1. DATABASE_URL (Connection Pooler / Supavisor - Transaction Mode, Port 6543):
#    Used by Express runtime / Prisma Client to handle high-concurrency connection pools.
#    Append '?pgbouncer=true&sslmode=require' for Prisma compatibility.
#    Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres.yourprojectref:your_database_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# 2. DIRECT_URL (Direct Connection - Port 5432):
#    Required by Prisma CLI to execute migrations (prisma migrate dev / deploy) and introspection.
#    Migrations require a direct connection because DDL statements and advisory locks cannot run in pooled transaction mode.
#    Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL="postgresql://postgres:your_database_password@db.yourprojectref.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# OPTIONAL: Local Offline Development with Docker (Alternative to Supabase)
# ------------------------------------------------------------------------------
# If developing offline without an active internet connection to Supabase:
# DATABASE_URL="postgresql://pms_user:pms_password@localhost:5432/pms_dev?schema=public"
# DIRECT_URL="postgresql://pms_user:pms_password@localhost:5432/pms_dev?schema=public"

# Test Database Connection (Required for running integration & financial test suites)
DATABASE_TEST_URL="postgresql://pms_user:pms_password@localhost:5432/pms_test?schema=public"

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Generate secure 64+ char random keys for production: openssl rand -base64 48
# Note: Initial MVP uses Express JWT authentication. Supabase Auth is an optional future ADR.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
SESSION_COOKIE_NAME=pms_session
COOKIE_SECURE=false

# System & Localization
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Document Storage (Module 9: Documents)
# Initial MVP uses local server disk storage. S3 or Supabase Storage are optional future ADRs.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Backup Configuration (Module 10: Data Backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Logging & Observability
LOG_LEVEL=info
