# ==============================================================================
# Property Management System (PMS) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production environment.
# NEVER commit .env files containing real secrets, keys, or passwords.
# ==============================================================================

# Application Environment & Server Settings
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://pms_user:pms_password@localhost:5432/pms_dev?schema=public

# Test Database Connection (Required for running integration & financial test suites)
DATABASE_TEST_URL=postgresql://pms_user:pms_password@localhost:5432/pms_test?schema=public

# Authentication & Security
# Generate secure 64+ char random keys for production: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
SESSION_COOKIE_NAME=pms_session
COOKIE_SECURE=false

# System & Localization
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Document Storage (Module 9: Documents)
# Options: local | s3 (local is default for MVP)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Backup Configuration (Module 10: Data Backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Logging & Observability
LOG_LEVEL=info

