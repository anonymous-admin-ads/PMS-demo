// ==============================================================================
// Property Management System (PMS) - Prisma Database Schema
// ==============================================================================
// Target Database: PostgreSQL hosted and managed by Supabase
// Currency Standard: Indian Rupee (INR) stored with Decimal(12, 2)
// Multi-tenancy: Strictly owner-scoped data boundaries
// Connection Strategy:
//   - url: Pooled connection string (Supabase connection pooler / Supavisor, port 6543)
//   - directUrl: Direct connection string (port 5432) for Prisma migrations
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL_APARTMENT
  INDEPENDENT_HOUSE
  PG_HOSTEL
  COMMERCIAL
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  ARCHIVED
}

enum TenancyStatus {
  ACTIVE
  ENDED
  PENDING
}

enum ChargeType {
  RENT
  WATER
  ELECTRICITY
  MAINTENANCE
  LATE_FEE
  SECURITY_DEPOSIT
  OTHER
}

enum ChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum WaterSplitType {
  METERED_READING
  EQUAL_SPLIT_PER_UNIT
  OCCUPANT_WEIGHTED
  FIXED_MONTHLY
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

enum DocumentCategory {
  LEASE_AGREEMENT
  TENANT_ID_PROOF
  UTILITY_BILL
  PAYMENT_RECEIPT
  PROPERTY_TAX_DEED
  INSPECTION_REPORT
  OTHER
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
}

// ------------------------------------------------------------------------------
// Core Entities
// ------------------------------------------------------------------------------

model Owner {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  currency     String      @default("INR")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Ownership relationships
  properties   Property[]
  tenants      Tenant[]
  payments     Payment[]
  documents    Document[]
  backupLogs   BackupLog[]

  @@index([email])
}

model Property {
  id            String       @id @default(cuid())
  ownerId       String
  name          String
  propertyType  PropertyType
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String?
  bankDetails   String?      // Notes or UPI ID for rent deposits
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  owner         Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  units         Unit[]
  documents     Document[]
  waterBills    WaterBill[]

  @@index([ownerId])
  @@index([ownerId, archivedAt])
}

model Unit {
  id              String      @id @default(cuid())
  propertyId      String
  unitNumber      String      // Flat/Door/Room identifier (e.g. "Flat 101", "Villa 4")
  floorNumber     Int?
  bedrooms        Int?
  bathrooms       Int?
  monthlyRent     Decimal     @db.Decimal(12, 2)
  securityDeposit Decimal?    @db.Decimal(12, 2)
  status          UnitStatus  @default(AVAILABLE)
  waterMeterId    String?
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenancies       Tenancy[]
  waterBills      WaterBill[]
  documents       Document[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId, status])
}

model Tenant {
  id           String      @id @default(cuid())
  ownerId      String
  fullName     String
  phone        String
  email        String?
  idProofType  String?     // Aadhaar, PAN, Passport, Voter ID
  idProofNumber String?
  emergencyContact String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner        Owner       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tenancies    Tenancy[]
  documents    Document[]

  @@index([ownerId, fullName])
  @@index([ownerId, phone])
}

model Tenancy {
  id              String        @id @default(cuid())
  tenantId        String
  unitId          String
  moveInDate      DateTime
  moveOutDate     DateTime?
  agreedRent      Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal?      @db.Decimal(12, 2)
  depositPaid     Boolean       @default(false)
  depositReturned Decimal?      @db.Decimal(12, 2)
  status          TenancyStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  charges         Charge[]
  bills           Bill[]
  documents       Document[]

  @@index([tenantId, status])
  @@index([unitId, status])
}

// ------------------------------------------------------------------------------
// Billing & Charges Models (Modules 4, 5, 6)
// ------------------------------------------------------------------------------

model Bill {
  id            String       @id @default(cuid())
  tenancyId     String
  billNumber    String       @unique // e.g., BILL-202610-001
  billingPeriod String       // Format: "YYYY-MM" (e.g. "2026-10")
  issueDate     DateTime     @default(now())
  dueDate       DateTime
  totalAmount   Decimal      @db.Decimal(12, 2)
  paidAmount    Decimal      @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal      @db.Decimal(12, 2)
  status        BillStatus   @default(ISSUED)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenancy       Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  charges       Charge[]

  @@index([tenancyId, billingPeriod])
  @@index([status, dueDate])
}

model Charge {
  id          String              @id @default(cuid())
  tenancyId   String
  billId      String?
  type        ChargeType
  description String?
  periodKey   String?             // Unique key per period to prevent duplicate charges: e.g. "2026-10-RENT"
  amount      Decimal             @db.Decimal(12, 2)
  dueDate     DateTime
  status      ChargeStatus        @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenancy     Tenancy             @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  bill        Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  waterBill   WaterBill?

  @@unique([tenancyId, periodKey])
  @@index([tenancyId, dueDate])
  @@index([status, dueDate])
}

model WaterBill {
  id              String         @id @default(cuid())
  propertyId      String
  unitId          String?
  chargeId        String?        @unique
  billingPeriod   String         // e.g. "2026-10"
  splitType       WaterSplitType @default(METERED_READING)
  previousReading Decimal?       @db.Decimal(10, 2)
  currentReading  Decimal?       @db.Decimal(10, 2)
  consumption     Decimal?       @db.Decimal(10, 2)
  ratePerUnit     Decimal?       @db.Decimal(10, 2)
  totalAmount     Decimal        @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit            Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  charge          Charge?        @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([propertyId, billingPeriod])
  @@index([unitId, billingPeriod])
}

// ------------------------------------------------------------------------------
// Payment & Allocation Models (Module 4, 7)
// ------------------------------------------------------------------------------

model Payment {
  id             String              @id @default(cuid())
  ownerId        String
  receiptNumber  String              @unique // Unique sequential receipt: e.g. REC-2026-0001
  amount         Decimal             @db.Decimal(12, 2)
  paymentDate    DateTime            @default(now())
  method         PaymentMethod
  reference      String?             // Bank UTR / UPI reference / Cheque number
  notes          String?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  owner          Owner               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  documents      Document[]

  @@index([ownerId, paymentDate])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  chargeId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  charge    Charge   @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
}

// ------------------------------------------------------------------------------
// Documents & Backup Models (Modules 9, 10)
// ------------------------------------------------------------------------------

model Document {
  id          String           @id @default(cuid())
  ownerId     String
  propertyId  String?
  unitId      String?
  tenantId    String?
  tenancyId   String?
  paymentId   String?
  title       String
  category    DocumentCategory
  fileName    String
  fileUrl     String
  fileSize    Int              // In bytes
  mimeType    String
  uploadedAt  DateTime         @default(now())

  owner       Owner            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  property    Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit        Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenancy     Tenancy?         @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([ownerId, category])
  @@index([tenantId])
  @@index([propertyId])
}

model BackupLog {
  id           String       @id @default(cuid())
  ownerId      String
  fileName     String
  fileSize     BigInt
  backupType   String       // MANUAL | SCHEDULED
  status       BackupStatus @default(PENDING)
  checksum     String?      // SHA256 verification hash
  errorMessage String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  owner        Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
}
