{
  "name": "pms-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Property Management System (PMS) - High-reliability, lightweight multi-property rental & billing platform",
  "keywords": [
    "pms",
    "property-management",
    "rent-ledger",
    "billing",
    "typescript"
  ],
  "author": "PMS Engineering Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "lint:fix": "pnpm --filter \"./apps/*\" lint:fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,prisma}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,md,prisma}\"",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck",
    "test": "pnpm --filter \"./apps/*\" test",
    "test:unit": "pnpm --filter \"./apps/*\" test:unit",
    "test:integration": "pnpm --filter \"./apps/*\" test:integration",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=database/schema.prisma",
    "db:studio": "prisma studio --schema=database/schema.prisma",
    "db:seed": "node database/seed.js"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}

